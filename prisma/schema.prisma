generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  authProviderId String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    Membership[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Workspace {
  id             String       @id @default(uuid())
  name           String
  primaryDomain  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  websites       Website[]
  brains         Brain[]
  integrations   Integration[]
  metrics        Metric[]
  goals          Goal[]
  opportunities  Opportunity[]
  drafts         ContentDraft[]

  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Website {
  id            String        @id @default(uuid())
  url           String
  crawlStatus   CrawlStatus   @default(PENDING)
  pageCount     Int           @default(0)
  lastCrawledAt DateTime?
  error         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  pages         CrawledPage[]

  @@index([workspaceId])
}

model CrawledPage {
  id          String   @id @default(uuid())
  url         String
  title       String?
  markdown    String
  contentHash String
  crawledAt   DateTime @default(now())

  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, url])
  @@index([websiteId])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model UsageRecord {
  id           String   @id @default(uuid())
  provider     String
  model        String
  operation    String
  inputTokens  Int
  outputTokens Int
  costCents    Float
  createdAt    DateTime @default(now())

  organizationId String?
  workspaceId    String?

  @@index([organizationId, createdAt])
}

model Brain {
  id          String       @id @default(uuid())
  version     Int
  status      BrainStatus  @default(DRAFT)
  generatedAt DateTime     @default(now())

  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  facts       BrainFact[]

  @@unique([workspaceId, version])
  @@index([workspaceId, status])
}

model BrainFact {
  id           String       @id @default(uuid())
  category     FactCategory
  key          String
  value        String
  confidence   Float        @default(0.5)
  sourceType   SourceType   @default(INFERENCE)
  sourceUrls   String[]
  isUserLocked Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  brainId      String
  brain        Brain        @relation(fields: [brainId], references: [id], onDelete: Cascade)

  @@index([brainId, category])
}

enum BrainStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum FactCategory {
  PRODUCT
  AUDIENCE
  POSITIONING
  COMPETITOR
  VOICE
  CONSTRAINT
}

enum SourceType {
  CRAWL
  SEARCH
  USER
  INFERENCE
}

model Integration {
  id                String            @id @default(uuid())
  provider          String
  status            IntegrationStatus @default(ACTIVE)
  externalAccountId String?
  siteUrl           String?
  lastSyncAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  credential  Credential?

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model Credential {
  id               String    @id @default(uuid())
  encryptedPayload String
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  integrationId String      @unique
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model Metric {
  id          String   @id @default(uuid())
  source      String
  metricType  String
  query       String?
  page        String?
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  date        DateTime

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, source, date])
  @@index([workspaceId, query])
}

enum IntegrationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model Goal {
  id          String   @id @default(uuid())
  description String
  metricType  String
  targetValue Int
  targetDate  DateTime
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model Opportunity {
  id              String    @id @default(uuid())
  type            String
  title           String
  reasoning       String
  evidence        String[]
  expectedImpact  String
  confidence      Float
  effort          String
  priorityScore   Float
  status          String    @default("OPEN")
  risks           String?
  decidedAt       DateTime?
  decidedBy       String?
  decisionNote    String?
  dismissReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  drafts      ContentDraft[]

  @@index([workspaceId, status, priorityScore])
}

model ContentDraft {
  id            String   @id @default(uuid())
  format        String
  title         String
  body          String
  status        String   @default("DRAFT")
  score         Float?
  scoreReasons  String[]
    rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([opportunityId])
}