# ---------------------------------------------------------------------------
# AIFDM — required environment variables
# Copy to .env.local for development. Set all of these in your host (Vercel etc.)
# before deploying: the app throws at runtime if any are missing.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Neon Postgres. src/lib/db.ts uses @prisma/adapter-neon, so this MUST be a Neon
# connection string (the pooled one, ending in -pooler). A plain Postgres URL
# from another provider will not work without swapping the adapter.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth (Clerk) -----------------------------------------------------------
# Organizations must be enabled in the Clerk dashboard: requireOrg() rejects any
# request without an active organization. Needed at BUILD time as well as runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."

# --- AI ---------------------------------------------------------------------
# Read implicitly by @ai-sdk/openai. Models used: gpt-4o (strong), gpt-4o-mini (fast).
OPENAI_API_KEY="sk-..."

# --- Crawling ---------------------------------------------------------------
FIRECRAWL_API_KEY="fc-..."

# --- Credential encryption --------------------------------------------------
# AES-256-GCM key for Google OAuth tokens at rest (src/lib/crypto/envelope.ts).
# MUST be at least 32 characters. Generate with: openssl rand -base64 32
# Rotating this makes every stored Google credential undecryptable — users must
# reconnect Search Console.
ENCRYPTION_KEY="change-me-at-least-32-characters-long"

# --- Google Search Console --------------------------------------------------
# OAuth client of type "Web application" with the Search Console API enabled.
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# OPTIONAL. Leave this unset and the redirect URI follows the host the request
# arrived on, so the same deployment works on its *.vercel.app URL and on a
# custom domain added later. Set it only to pin one specific URI.
# Registering the URI in Google Cloud is required either way:
#   https://<your-host>/api/integrations/google/callback
# GOOGLE_REDIRECT_URI="https://your-domain.com/api/integrations/google/callback"

# --- GitHub publishing ------------------------------------------------------
# Used by src/lib/publish/github.ts to push a branch and open a PR.
# Needs write access to every repository a workspace publishes to.
# NOTE: this is a single global token, not per-workspace — see README.
GITHUB_TOKEN="ghp_..."

# --- Background jobs (Inngest) ----------------------------------------------
# Read implicitly by the Inngest SDK. Without these the app runs in dev mode and
# NO background job (crawl, brain, GSC sync, opportunities, content, publish)
# will execute in production.
INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="signkey-prod-..."
